# Base URL for vLLM's OpenAI-compatible API
VLLM_BASE_URL=http://13.158.181.44:8000/v1
VLLM_API_KEY=EMPTY_KEY

# Model name as served by vLLM
VLLM_MODEL_ID=Qwen/Qwen2.5-VL-32B-Instruct-AWQ

# Mixing Desk backend: file storage
MIXING_DESK_BACKEND=file
MIXING_DESK_DIR=./data/mixing_desk

# InfoAgent defaults
INFOAGENT_TEMPERATURE=0.2
INFOAGENT_MAX_TOKENS=12000

STRATEGIST_MAX_TOKENS=1000
STRATEGIST_TEMPERATURE=0.2
STRATEGIST_MAX_IMAGES=2

SUCCESS_MODE=final_flip
FORCE_TARGET_CLASS=0
REQUIRE_CONF_IN_FLIP=false

INCLUDE_FINALCHECK_IN_LOSS=true
FINALCHECK_LOSS_WEIGHT=0.35

MIXER_SURROGATE_WEIGHT=0.25
MIXER_FINAL_WEIGHT=0.75